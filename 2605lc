class Solution {
    public int minNumber(int[] nums1, int[] nums2) {
        int smallest1 = Integer.MAX_VALUE;
        int n = nums1.length;
        for(int i =0 ; i<n; i++){
            smallest1 = Math.min(nums1[i], smallest1);  
        }

        int smallest2 = Integer.MAX_VALUE;
        int m = nums2.length;
        for(int j =0 ; j<m; j++){
            smallest2 = Math.min(nums2[j], smallest2);           
        }
        int common = Integer.MAX_VALUE;

        for (int i = 0; i < nums1.length; i++) {
            for (int j = 0; j < nums2.length; j++) {
                if (nums1[i] == nums2[j]) {
                    common = Math.min(common, nums1[i]);
                }
            }
        }

        if (common != Integer.MAX_VALUE) {
            return common;
        }

        int a = Math.min(smallest1, smallest2);
        int b = Math.max(smallest1, smallest2);

        return a * 10 + b;
    }
}
