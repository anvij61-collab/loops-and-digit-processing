class Solution {
    public int getLucky(String s, int k) {

        char[] ch = s.toCharArray();
        int[] nums = new int[ch.length];
        for(int i = 0; i < ch.length; i++) {
            nums[i] = ch[i] - 'a' + 1;
        }

        int sum = 0;
        for(int num : nums) {
            while(num > 0) {
                int digit = num % 10;
                sum += digit;
                num = num / 10;
            }
        }

        for(int i = 0; i < k - 1; i++) {
            int num1 = sum;
            sum = 0;
            while(num1 > 0) {
                int digit = num1 % 10;
                sum += digit;
                num1 = num1 / 10;
            }
        }
        return sum;
    }
}


