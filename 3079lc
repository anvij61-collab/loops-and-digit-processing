class Solution {
    public int sumOfEncryptedInt(int[] nums) {
        int sum =0;
        for(int i : nums){
            int orignal =i;
             int max = 0;
             while(i>0){
                int temp =i%10;
                max = Math.max(max,temp); 
                i /=10;
            }

            int newnum =0;
            int place =1;
            while(orignal>0){
                int digit =  orignal %10;
                newnum += max*place;
                place *= 10;
                orignal /=10;
            }
            sum += newnum;
        }

        return sum;
    }
}
