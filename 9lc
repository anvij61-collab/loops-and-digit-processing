class Solution {
    public boolean isPalindrome(int n) {
        if(n<0){
            return false;
        }

        int place =1;
        while(n/place >= 10){
            place *= 10;
        }
        boolean palindrome = true;
        while(place>1 ){
            int first = n/place;
            int last = n%10;

        if(first != last){
            palindrome = false;
            break;
        }

        n = (n% place) /10;
        place = place /100;

        
        }
        if(palindrome){
            return true;
        }
        else{
            return false;
        }
    }

